# ─── Supabase (required for blog) ────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy these from:
# Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── SEO ────────────────────────────────────────────────────────────────────
# Public site URL (no trailing slash) — used for canonical URLs, sitemap, OG tags
VITE_SITE_URL=https://www.tlrs.co.uk

# Google Analytics 4 measurement ID (optional, e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token (optional)
VITE_GSC_VERIFICATION=

# ─── Blog admin ───────────────────────────────────────────────────────────────
# The admin account is created once inside your Supabase dashboard:
# Authentication → Users → "Invite user" (or Add user)
# Then log in at /blog/admin with that email + password.

# Skip Playwright prerender during build (optional, for faster CI)
# SKIP_PRERENDER=1
